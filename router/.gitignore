# Logs
logs
*.log
npm-debug.log*

# Runtime data and caches
.crabcode
.lancedb
.rag-cache/
# The GGUF weights. ANCHORED to the router root: a bare 'models/'
# also matched src/models/, which holds SOURCE FILES (the model
# manager, the embedding manager) that the router imports. Seven
# tracked files import from src/models/ — a fresh clone could not
# build the router.
/models/
!/models/placeholder.txt

# Dependency directories
node_modules/

# Compiled output
dist
build
out

# Local env files
.env
.env.*

# Local config
src/config/config.local.ts
src/config/config.local.js

# OS metadata
.DS_Store
Thumbs.db

# Generated project artifacts.
#
# The scratch/ directory holds verification scripts and analysis notes, but a
# test run that scaffolds a project must NEVER write its output into the
# repository. Generated code belongs in the eval directory
# (D:\fedora backup\test), outside the repo.
#
# These patterns are a safety net: if a script ever writes a generated
# project here, it is ignored rather than committed.
scratch/.live-check/
scratch/.p0-ws/
scratch/*/node_modules/
scratch/.*-backup-*/
*.backup-*/
